# Session-local Claude Code permission grants (machine-specific, not shared)
.claude/settings.local.json

# External scientific codebases (MCFM, Pepper, QCDLoop) are tracked as git submodules
# under software/ — see the submodule table in README.md. Their contents live in the
# submodule repos, so nothing to ignore here.

# Scratch root: everything generated by dev/tools/ against the clones (Doxygen-derived
# roadmap, symbol index, drafts, stage-2 check tables) lands under dev/tmp/.
*.tsv
*.scribe
# ...which is what the two rules above were for, but they miss the JSON assets
# (symbol_index.json, cleanup_index.json) and those embed the operator's absolute
# repo root -- so `git add -A` would commit local PII. Anchored to the repo root
# with a leading slash: an unanchored `dev/tmp/` would also match the archived
# `evals/**/dev/tmp/` run snapshots and re-hide them.
/dev/tmp/

# Exception: archived run snapshots under evals/ are evidence, not scratch. The
# roadmap TSV is the candidate list a run's model actually chose from, so it has
# to be committed alongside the symbol_index.json that already is. Live scratch in
# dev/tmp/assets/ stays ignored.
!evals/**/dev/tmp/assets/*.tsv

# jobrunner run artifacts (scratch of `jobrunner submit`); archived logs under
# tests/*/jobnode.archive/ are kept and tracked deliberately.
job.submit
job.output
job.error
**/jobnode/

# Test run artifacts (Pepper doctest event dumps, caches). Anything under software/
# belongs to a submodule and is tracked there, so nothing submodule-internal is listed.
*.debug
*.hdf5
pepper_cache/
pepper_logs/

# Python / editor cruft
__pycache__/
*.pyc
.venv/
.DS_Store
